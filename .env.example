 # Supabase hosted. Never commit real secrets.
 NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
 NEXT_PUBLIC_SUPABASE_ANON_KEY=your-hosted-anon-key
 # Service-role key: DEV-ONLY untuk bun run seed:auth. Jangan commit isi asli.
 SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Password for tenant accounts created by bun run db:prod (never commit a value).
TENANT_DEFAULT_PASSWORD=
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
GOTRUE_EXTERNAL_GOOGLE_SECRET=your-google-client-secret
