{
  "name": "porsi-terakhir",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "next build",
    "predev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "prestart": "node -e \"const fs=require('fs');const p='.next/BUILD_ID';if(!fs.existsSync(p)){console.error('MISSING BUILD: run bun run build first (never serve dev-cache via start)') ;process.exit(1)}\"",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:push": "supabase db push --linked",
    "db:migrations": "supabase migration list --linked",
    "seed:auth": "bun scripts/seed-auth.ts",
    "db:seed": "bun scripts/seed-demo.ts",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.1",
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "supabase"
  ]
}
